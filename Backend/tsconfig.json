{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0"
  },
  "include": ["API/**/*", "models/**/*", "Testing/unit-test/auth.controller.spec.ts"],
  "exclude": ["node_modules", "**/*.spec.ts", "migrations", "config/config.js"]
}