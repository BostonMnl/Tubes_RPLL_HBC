{
  "info": {
    "name": "RPLL 6 Controllers Automated Test Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup & Authentication",
      "item": [
        {
          "name": "Auth - Login Staff",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data.token) {",
                  "    pm.collectionVariables.set(\"token_staff\", response.data.token);",
                  "    console.log(\"Token Staff Saved!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff@gmail.com\",\n  \"password\": \"12321\"\n}"
            },
            "url": {"raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"]}
          }
        },
        {
          "name": "Auth - Login Manager",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data.token) {",
                  "    pm.collectionVariables.set(\"token_manager\", response.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@gmail.com\",\n  \"password\": \"12321\"\n}"
            },
            "url": {"raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"]}
          }
        },
        {
          "name": "Auth - Login Supervisor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data.token) {",
                  "    pm.collectionVariables.set(\"token_supervisor\", response.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"supervisor@gmail.com\",\n  \"password\": \"12321\"\n}"
            },
            "url": {"raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"]}
          }
        }
      ]
    },
    {
      "name": "1. Reimburse Controller",
      "item": [
        {
          "name": "1.1 Create Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data.reimburse) {",
                  "    pm.collectionVariables.set(\"reimburse_id_pending\", response.data.reimburse.reimburse_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token_staff}}"}],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "nominal", "value": "50000", "type": "text"},
                {"key": "tanggal", "value": "2026-05-03", "type": "text"},
                {"key": "keterangan", "value": "Transport", "type": "text"},
                {"key": "gambar", "type": "file", "src": []}
              ]
            },
            "url": {"raw": "{{base_url}}/api/reimburse", "host": ["{{base_url}}"], "path": ["api", "reimburse"]}
          }
        },
        {
          "name": "1.2 Update Pending Request",
          "request": {
            "method": "PUT",
            "header": [{"key": "Authorization", "value": "Bearer {{token_staff}}"}],
            "body": {
              "mode": "formdata",
              "formdata": [{"key": "nominal", "value": "60000", "type": "text"}]
            },
            "url": {"raw": "{{base_url}}/api/reimburse/{{reimburse_id_pending}}", "host": ["{{base_url}}"], "path": ["api", "reimburse", "{{reimburse_id_pending}}"]}
          }
        }
      ]
    }
  ],
  "variable": [
    {"key": "base_url", "value": "http://10.93.173.158:3000", "type": "string"},
    {"key": "token_staff", "value": ""},
    {"key": "token_manager", "value": ""},
    {"key": "token_supervisor", "value": ""},
    {"key": "reimburse_id_pending", "value": ""}
  ]
}